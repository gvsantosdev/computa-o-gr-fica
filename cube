#include <GL/glut.h>
#include <math.h>

float angleY = 2.0f;
float angleX = 2.0f;
float angleZ = 2.0f;
float raio = 2.0f;
float camX = 2.0f;
float camY = 2.0f;
float camZ = 2.0f;


void keyboard(unsigned char key, int x, int y) {
    switch (key) {
        case 'z':
            camZ += 1.0f;
            break;

        case 'x':
            camZ -= 1.0f;
            break;
    }

    glutPostRedisplay();
}

void arrow_keys(int a_keys, int x, int y) {
    switch(a_keys){
        case GLUT_KEY_LEFT:
            if (angleX > 360) { angleX = 0;} 
            angleX -= 1.0f;
            break;
        case GLUT_KEY_RIGHT:
            if (angleX > 360) { angleX = 0;} 
            angleX += 1.0f;
            break;
        case GLUT_KEY_DOWN:
            if (angleY > 360) { angleY = 0;} 
            angleY -= 1.0f;
            break;
        case GLUT_KEY_UP:
            if (angleY > 360) { angleY = 0;} 
            angleY += 1.0f;
            break;
}
glutPostRedisplay();
}

void drawcube() { 
    glColor3f(1.0f, 0.0f, 0.0f);
    glutSolidCube(1);
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    glLoadIdentity();
    camX = sin(angleX) * raio;
    camY = cos(angleY) * raio;

    gluLookAt(
        camX, camY, camZ,   // posição da câmera
        0.0, 0.0, 0.0,    // ponto para onde olha
        0.0, 1.0, 0.0     // cima
    );
    drawcube();
    glutSwapBuffers();
}

void reshape(int w, int h) {
    glViewport(0, 0, w, h);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluPerspective(45.0, (double)w / h, 0.1, 100.0);
    glMatrixMode(GL_MODELVIEW);
} 

